{
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/ogd/test-login.mjs": {
      "maxDuration": 240,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    },
    "api/ogd/check-report.mjs": {
      "maxDuration": 240,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    },
    "api/ogd/sync-members.mjs": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    },
    "api/ogd/push-changes.mjs": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    }
  },
  "git": {
    "deploymentEnabled": {
      "feature/ogd-chapter-connections": false
    }
  }
}
