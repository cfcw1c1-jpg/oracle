{
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ogd/test-login.mjs": {
      "maxDuration": 240,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    },
    "api/ogd/check-report.mjs": {
      "maxDuration": 240,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    }
  }
}
