{
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/ogd/test-login",
      "destination": "/api/ogd/browser?task=test-login"
    },
    {
      "source": "/api/ogd/check-report",
      "destination": "/api/ogd/browser?task=check-report"
    },
    {
      "source": "/api/ogd/sync-members",
      "destination": "/api/ogd/browser?task=sync-members"
    },
    {
      "source": "/api/ogd/push-changes",
      "destination": "/api/ogd/browser?task=push-changes"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/ogd/browser.mjs": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    }
  },
  "git": {
    "deploymentEnabled": {
      "feature/ogd-chapter-connections": false
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
